  },
  "ordinary_fp_boundary": {
    "default_environment_semantics_compatible": true,
    "local_value_memory_closure": "Core value arguments carry no pointers. Original byval/sret/lambda/memcpy/memset storage is core-local; no ordinary global/TLS/errno/numerical callback access was found.",
    "blocker": "Fixed-RNE/no-fast ordinary FP still permits NaN-result sign/payload choices and unchanged SNaN propagation. Constrained math guarantees quiet NaN results. Source product32, next-word bounds and refusal code bitcast intermediate FP results, so status quarantine alone is not an exact-word NaN/use proof.",
    "example": "LLVM permits ordinary fmul(SNaN,1.0) -> SNaN; this is not claimed as a demonstrated visible nine-core mismatch.",
    "unchanged_bits": "Integer/select/copy/fneg/fabs-only NaN passthrough stays bit-preserving; signed-zero and subnormal semantics must remain exact.",
    "additional_proof_needed": "Before any ordinary/pure-core change, prove all computed-NaN bit uses unobservable/equivalent on the complete admitted domain, or preserve those sites on an exact constrained route. Do not infer this merely from finite fixtures or default precise flags."
  },
