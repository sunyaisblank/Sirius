// Only private 16-lane raw kernels include this header. Each old eight-lane
// subgroup retains its own reduction decision under the incoming mask.
static inline varying bool SiriusSubgroup8All_0(varying bool value) {
    uniform uint32_t incoming = (uniform uint32_t)lanemask();
    varying bool active = (incoming & (1U << programIndex)) != 0U;
    varying bool selected = active ? value : true;
    uniform bool low = all(selected | (programIndex >= 8));
    uniform bool high = all(selected | (programIndex < 8));
    return (programIndex < 8) ? low : high;
}

static inline varying bool SiriusSubgroup8Any_0(varying bool value) {
    uniform uint32_t incoming = (uniform uint32_t)lanemask();
    varying bool active = (incoming & (1U << programIndex)) != 0U;
    varying bool selected = active ? value : false;
    uniform bool low = any(selected & (programIndex < 8));
    uniform bool high = any(selected & (programIndex >= 8));
    return (programIndex < 8) ? low : high;
}
