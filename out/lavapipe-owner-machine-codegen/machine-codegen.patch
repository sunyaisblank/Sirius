+#if !GALLIVM_USE_ORCJIT
+extern "C"
+bool
+lp_set_mcjit_codegen_none_after_ir(LLVMExecutionEngineRef engine)
+{
+#if LLVM_VERSION_MAJOR == 21
+   if (!engine)
+      return false;
+   llvm::ExecutionEngine *jit = llvm::unwrap(engine);
+   std::lock_guard<llvm::sys::Mutex> locked(jit->lock);
+   llvm::TargetMachine *target = jit->getTargetMachine();
+   if (!target || target->getOptLevel() != llvm::CodeGenOptLevel::Default)
+      return false;
+
+   /* MCJIT builds its machine-pass pipeline lazily in emitObject.  This
+    * engine owns the target; the shared LLVMContext and memory pool do not
+    * carry this policy. CPU/features/FP options and IR attributes stay put.
+    */
+   target->setOptLevel(llvm::CodeGenOptLevel::None);
+   return true;
+#else
+   /* No unreviewed LLVM-version behavior is admitted by this private hook. */
+   (void)engine;
+   return false;
+#endif
+}
+#endif
+
 extern "C"
 void
 lp_free_generated_code(struct lp_generated_code *code)
