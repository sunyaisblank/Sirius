+            m = re.fullmatch(r'\[FactoredEndpoint\] returned: call=(\d+);success=([01]);pipeline_ms=([^;\s]+);submit_wait_ms=([^;\s]+);total_ms=([^;\s]+)', line)
+            if m:
+                assert m[2] == '1'
+                ends.append({'call': int(m[1]), 'pipeline_ms': number(m[3]), 'submit_wait_ms': number(m[4]), 'total_ms': number(m[5])})
+        assert tuple(stage for stage, _ in selected) == STAGES
+        names = selected_names(context, arm, bool(wide))
+        for stage, digest in selected:
+            assert digest == context.arms[arm]['arrays'][names[stage]]['sha256'], (wide, stage)
+        assert endpoint == [dict(selected)['endpoint']]
+        assert starts == list(enumerate(FACTORED_ROWS)) and [q['call'] for q in ends] == list(range(14))
+        readbacks = {}
+        for i, rows in enumerate(FACTORED_ROWS):
+            key = f'factored_endpoint_readback_0_{wide}_{i}'
+            value = fields(props[key])
+            assert set(value) == {'rows', 'bytes', 'sha256'}
+            assert value['rows'] == str(rows) and value['bytes'] == str(rows * 3829 * 4)
+            assert re.fullmatch('[0-9a-f]{64}', value['sha256'])
+            readbacks[key] = value
+        records.append({'wide': bool(wide), 'declined_RTE32': False, 'selected_arrays': names,
+                        'selected_stage_sha256': dict(selected), 'all14_calls': ends, 'readbacks': readbacks})
+    return {'routes': records, 'routes_count': 2, 'complete_readbacks': 28,
+            'scope': 'Actual native default plus wide/FMA selection joined to accepted producer arrays. All original reference/refusal/recovery assertions are the unchanged completed test; no historical software digest equality is asserted.'}
