+def physical_identity(path):
+    assert path.is_file()
+    digest = hashlib.sha256()
+    size = 0
+    with path.open('rb') as stream:
+        while True:
+            block = stream.read(1024 * 1024)
+            if not block: break
+            size += len(block)
+            digest.update(block)
+    return {'bytes': size, 'sha256': digest.hexdigest()}
+
+
+def physical(key):
+    assert type(key) is str
+    return Path(key) if key.startswith('/') else local(key)
+
+def pin(value):
+    assert type(value) is dict and type(value['bytes']) is int and value['bytes'] >= 0
+    assert type(value['sha256']) is str and re.fullmatch('[0-9a-f]{64}', value['sha256'])
+    return {key: value[key] for key in ('bytes', 'sha256')}
+
+
+def local(relative):
+    logical = PurePosixPath(relative)
+    assert type(relative) is str and not logical.is_absolute() and str(logical) == relative
+    assert '\\' not in relative and all(p not in ('', '.', '..') for p in relative.split('/'))
+    path = ROOT / logical
+    assert path.resolve(strict=True) == path and path.is_relative_to(ROOT), relative
+    return path
