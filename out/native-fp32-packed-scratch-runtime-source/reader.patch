+def publish(path, result, context):
+    context.finish()
+    result['reader_bindings'] = dict(path=str(context.path.relative_to(ROOT)), **context.seal)
+    result['root_reader_admission'] = dict(path=str(context.admission_path.relative_to(ROOT)), **context.admission_seal)
+    result['native_provider_scope'] = 'Same-child observed SDK loader and AMD modules, exact Windows PID/birth and terminal post-seals; accessible consumer scope only. Windows sampled child WorkingSet is not aggregate Windows/GPU-memory accounting.'
+    payload = (json.dumps(result, indent=2, allow_nan=False) + '\n').encode()
+    assert len(payload) <= 32 * 1024 * 1024
+    assert path.parent.resolve(strict=True).is_relative_to(ROOT) and not path.exists()
+    with path.open('xb') as handle: handle.write(payload)
