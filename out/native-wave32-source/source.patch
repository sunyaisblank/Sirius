 // requesting 1.3 is compatible with both (specification section 1.7 evidence).
 constexpr std::uint32_t kApiVersion = VK_MAKE_API_VERSION(0, 1, 3, 0);
 
+#ifdef SIRIUS_HAS_RETAINED_COMPUTE
+// Private candidate: preserve the shader and full 64-thread workgroup while
+// reducing the hardware subgroup width for the exact native Transport module.
+// Physical capabilities are immutable for the logical device's lifetime.
+[[nodiscard]] bool NativeTransportWave32Supported(VkPhysicalDevice physical,
+                                                  const DeviceInfo& info) {
+    if (info.vendor_id != 0x1002 || info.api_version < VK_API_VERSION_1_3 ||
+        (info.kind != DeviceKind::kIntegratedGpu && info.kind != DeviceKind::kDiscreteGpu) ||
+        RetainedUsesPortableArithmetic(info))
+        return false;
+    VkPhysicalDeviceSubgroupSizeControlFeatures subgroup{
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES,
+    };
+    VkPhysicalDeviceFeatures2 features{
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2,
+        .pNext = &subgroup,
+    };
+    vkGetPhysicalDeviceFeatures2(physical, &features);
+    if (subgroup.subgroupSizeControl != VK_TRUE) return false;
+    VkPhysicalDeviceSubgroupSizeControlProperties sizes{
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_PROPERTIES,
+    };
+    VkPhysicalDeviceProperties2 properties{
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+        .pNext = &sizes,
+    };
+    vkGetPhysicalDeviceProperties2(physical, &properties);
+    return sizes.minSubgroupSize <= 32 && sizes.maxSubgroupSize >= 32 &&
+           sizes.maxComputeWorkgroupSubgroups >= 2 &&
+           (sizes.requiredSubgroupSizeStages & VK_SHADER_STAGE_COMPUTE_BIT) != 0;
+}
+
+#endif
