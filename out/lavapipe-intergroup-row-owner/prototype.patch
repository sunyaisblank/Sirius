+/* A second, fail-closed gate after exact SPIR-V admission.  The scalar
+ * function-call context and all cross-invocation observability stay outside
+ * this mode.  These checks alone never authorize an arbitrary shader.
+ */
+static bool
+lp_intergroup_row_owner_eligible(const nir_shader *nir)
+{
+#if LP_VULKAN_IEEE32_ENABLED
+   if (lp_native_vector_width != 256 || nir->info.stage != MESA_SHADER_COMPUTE ||
+       !nir->info.cs.llvmpipe_intergroup_row_owner ||
+       nir->info.workgroup_size_variable ||
+       nir->info.workgroup_size[0] != 64 || nir->info.workgroup_size[1] != 1 ||
+       nir->info.workgroup_size[2] != 1 || nir->info.shared_size ||
+       nir->info.task_payload_size || nir->info.ray_queries ||
+       nir->info.uses_control_barrier || nir->info.uses_memory_barrier ||
+       nir->info.uses_wide_subgroup_intrinsics ||
+       nir->info.derivative_group != DERIVATIVE_GROUP_NONE ||
+       nir->info.cs.has_variable_shared_mem || nir->info.cs.has_cooperative_matrix ||
+       !exec_list_is_singular(&nir->functions))
+      return false;
+
+   nir_foreach_variable_with_modes(var, nir, nir_var_mem_shared | nir_var_mem_task_payload)
+      return false;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   if (!impl)
+      return false;
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type == nir_instr_type_call || instr->type == nir_instr_type_tex)
+            return false;
+         if (instr->type == nir_instr_type_alu) {
+            const char *name = nir_op_infos[nir_instr_as_alu(instr)->op].name;
+            if (strstr(name, "ddx") || strstr(name, "ddy"))
+               return false;
+         } else if (instr->type == nir_instr_type_intrinsic) {
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (nir_intrinsic_has_semantic(intr, NIR_INTRINSIC_SUBGROUP) ||
+                nir_intrinsic_has_semantic(intr, NIR_INTRINSIC_QUADGROUP))
+               return false;
+            const char *name = nir_intrinsic_infos[intr->intrinsic].name;
+            if (strstr(name, "atomic") || strstr(name, "barrier") ||
+                strstr(name, "shared") || strstr(name, "subgroup") ||
+                strstr(name, "shuffle") || strstr(name, "ballot") ||
+                strstr(name, "vote") || strstr(name, "quad") ||
+                strstr(name, "ddx") || strstr(name, "ddy") ||
+                strstr(name, "image") || strstr(name, "payload") ||
+                strstr(name, "ray_query") || strstr(name, "coop") ||
+                !strcmp(name, "reduce") || !strcmp(name, "elect") ||
+                !strcmp(name, "scan") || strstr(name, "_scan") ||
+                strstr(name, "read_invocation") || strstr(name, "read_first_invocation"))
+               return false;
+         }
+      }
+   }
+   return true;
+#else
+   return false;
+#endif
+}
 
