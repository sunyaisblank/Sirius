+      {0xe2,0xbe,0xef,0x14,0xd2,0x7c,0xcb,0x5f,0x80,0xbc,0xe2,0xeb,0xf6,0x3c,0x35,0x84,0x7c,0x0c,0xa4,0x0c},
+   };
+   if (sinfo->stage != VK_SHADER_STAGE_COMPUTE_BIT ||
+       sinfo->flags || sinfo->pSpecializationInfo ||
+       vk_find_struct_const(sinfo->pNext, PIPELINE_SHADER_STAGE_REQUIRED_SUBGROUP_SIZE_CREATE_INFO) ||
+       !sinfo->pName || strcmp(sinfo->pName, "main"))
+      return false;
+
+   const void *code;
+   size_t size;
+   VK_FROM_HANDLE(vk_shader_module, module, sinfo->module);
+   if (module) {
+      if (module->nir)
+         return false;
+      code = module->data;
+      size = module->size;
+   } else {
+      const VkShaderModuleCreateInfo *minfo =
+         vk_find_struct_const(sinfo->pNext, SHADER_MODULE_CREATE_INFO);
+      if (!minfo)
