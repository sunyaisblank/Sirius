+/* These three complete-row shaders have exactly one logical local owner,
+ * no cross-invocation state, and side-effect-free local invocations 1..63.
+ * Hash admission is deliberately independent of application labels/names.
+ */
+static bool
+lvp_intergroup_row_owner_spirv(const VkPipelineShaderStageCreateInfo *sinfo)
+{
+#if LP_VULKAN_IEEE32_ENABLED
+   static const unsigned char owner_sha1[][SHA1_DIGEST_LENGTH] = {
+      {0xc0,0xf3,0x8b,0x8b,0x39,0xd1,0x21,0x36,0x21,0x6a,0xf9,0x8f,0x34,0x65,0xf3,0x46,0x46,0x30,0x06,0x28},
