+groupshared uint retainedStageState[40 * 5];
+RetainedTriple ReadStageState(uint index) {
+    uint base = index * 5;
+    RetainedTriple r;
+    r.hi = RPFromBits(retainedStageState[base]);
+    r.lo = RPFromBits(retainedStageState[base + 1]);
+    r.tail = RPFromBits(retainedStageState[base + 2]);
+    r.error = RPFromBits(retainedStageState[base + 3]);
+    r.valid = retainedStageState[base + 4];
+    return r;
+}
+void WriteStageState(uint index, RetainedTriple r) {
+    uint base = index * 5;
+    retainedStageState[base] = RPBits(r.hi);
+    retainedStageState[base + 1] = RPBits(r.lo);
+    retainedStageState[base + 2] = RPBits(r.tail);
+    retainedStageState[base + 3] = RPBits(r.error);
+    retainedStageState[base + 4] = r.valid;
+}
