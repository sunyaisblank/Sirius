{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/bin/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTS": "ON",
                "SIRIUS_CONTRACT_MODE": "2",
                "SIRIUS_MANDATORY_TESTS": "ON",
                "SIRIUS_WERROR": "ON"
            }
        },
        {
            "name": "linux-gcc",
            "displayName": "Linux / WSL2, GCC 14, Release",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc-14",
                "CMAKE_CXX_COMPILER": "g++-14"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux / WSL2, GCC 14, Debug",
            "inherits": "linux-gcc",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux / WSL2, Clang 21, Release",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang-21",
                "CMAKE_CXX_COMPILER": "clang++-21"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux / WSL2, Clang 21, Debug",
            "inherits": "linux-clang",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "linux-gcc-sanitize",
            "displayName": "Linux / WSL2, GCC 14, ASan + UBSan + LSan",
            "inherits": "linux-gcc-debug",
            "cacheVariables": {
                "SIRIUS_SANITIZERS": "address-undefined",
                "SIRIUS_MANDATORY_TESTS": "ON"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows, MSVC 2022 17.10+, x64",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "macos",
            "displayName": "macOS, AppleClang (Xcode 16+), Release",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        {
            "name": "linux-ci",
            "displayName": "CI: strict gate build",
            "inherits": "linux-gcc",
            "cacheVariables": {
                "SIRIUS_MANDATORY_TESTS": "ON",
                "SIRIUS_WERROR": "ON",
                "SIRIUS_REQUIRE_VULKAN_RUNTIME": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "linux-gcc", "configurePreset": "linux-gcc" },
        { "name": "linux-gcc-debug", "configurePreset": "linux-gcc-debug" },
        { "name": "linux-clang", "configurePreset": "linux-clang" },
        { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
        { "name": "linux-gcc-sanitize", "configurePreset": "linux-gcc-sanitize" },
        { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Release" },
        { "name": "macos", "configurePreset": "macos" },
        { "name": "linux-ci", "configurePreset": "linux-ci" }
    ],
    "testPresets": [
        {
            "name": "linux-gcc",
            "configurePreset": "linux-gcc",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "linux-clang",
            "configurePreset": "linux-clang",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "linux-ci",
            "configurePreset": "linux-ci",
            "output": { "outputOnFailure": true },
            "execution": { "stopOnFailure": false }
        },
        {
            "name": "linux-gcc-sanitize",
            "configurePreset": "linux-gcc-sanitize",
            "output": { "outputOnFailure": true },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1:strict_string_checks=1",
                "LSAN_OPTIONS": "suppressions=${sourceDir}/sanitizers/lsan-vulkan.supp:print_suppressions=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            },
            "execution": { "stopOnFailure": true }
        }
    ]
}
