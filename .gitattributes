# The operating model is hashed into the compiled alignment authority.  Keep
# its checkout bytes identical on every host instead of allowing core.autocrlf
# to create a platform-local authority for one Git revision.
/tests/operating_model.json text eol=lf

# Viewer shader files are also hashed as source-root runtime products.
/src/sirius/app/viewer/shaders/RDSD003A.frag text eol=lf
/src/sirius/app/viewer/shaders/RDSD003A.vert text eol=lf
