#pragma once

#include <array>
#include <cstddef>
#include <string_view>

namespace sirius::base {

// Configured from tests/operating_model.json. Runtime capability reporting
// requires semantic equality with this authority, so an installed ledger
// cannot change a claim while retaining a schema shape that looks valid.
inline constexpr std::size_t kEmbeddedOperatingModelSize = @SIRIUS_OPERATING_MODEL_SIZE@;
inline constexpr std::string_view kEmbeddedOperatingModelSha256 =
    "@SIRIUS_OPERATING_MODEL_SHA256@";
inline constexpr std::array<std::string_view, @SIRIUS_OPERATING_MODEL_CHUNK_COUNT@>
    kEmbeddedOperatingModelChunks = {
@SIRIUS_OPERATING_MODEL_CPP_CHUNKS@};

inline constexpr bool kReleaseAlignmentEnforced = @SIRIUS_RELEASE_ALIGNMENT_ENFORCED@;
inline constexpr bool kQualificationAlignmentEnforced =
    @SIRIUS_QUALIFICATION_ALIGNMENT_ENFORCED@;
inline constexpr bool kEmbeddedAlignmentSatisfied = @SIRIUS_EMBEDDED_ALIGNMENT_SATISFIED@;
inline constexpr std::size_t kEmbeddedAlignmentReceiptSize = @SIRIUS_ALIGNMENT_RECEIPT_SIZE@;
inline constexpr std::array<std::string_view, @SIRIUS_ALIGNMENT_RECEIPT_CHUNK_COUNT@>
    kEmbeddedAlignmentReceiptChunks = {
@SIRIUS_ALIGNMENT_RECEIPT_CPP_CHUNKS@};

static_assert(!kReleaseAlignmentEnforced || kEmbeddedAlignmentSatisfied,
              "release binaries require a complete revision-bound alignment receipt");
static_assert(!(kReleaseAlignmentEnforced && kQualificationAlignmentEnforced),
              "release and qualification modes are mutually exclusive");

}  // namespace sirius::base
