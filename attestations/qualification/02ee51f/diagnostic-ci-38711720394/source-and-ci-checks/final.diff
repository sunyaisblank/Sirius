+                    "\"active_rectangle\":[{},{},{},{}],\"expected_identity\":[{},{},{},{}],"
+                    "\"physical_submissions\":{},\"maximum_attempts\":{},\"packet_hex\":\"{}\","
+                    "\"previous_record_hex\":{},\"current_record_hex\":\"{}\","
+                    "\"device_name_bytes_hex\":\"{}\"}}",
+                    sizeof(Real), sizeof(float), sizeof(Record),
