 SIRIUS_PB32_INLINE uint PB32Add(uint a, uint b) {
+#if defined(SIRIUS_RETAINED_NORMAL_SUM32)
+    // Normal finite inputs bounded by 2^124 cannot overflow binary32.
+    // RTE32 plus NoContraction gives the original rounded sum unless the
+    // nonzero subnormal result was flushed. Detect that case and use the
+    // untouched integer implementation below. Bitcasts preserve returned bits.
+    uint am = PB32Abs(a), bm = PB32Abs(b);
+    if (am >= 0x00800000u && am <= 0x7d800000u &&
+        bm >= 0x00800000u && bm <= 0x7d800000u) {
+#if defined(__cplusplus)
+        float af = std::bit_cast<float>(a), bf = std::bit_cast<float>(b);
+        volatile float native_sum = af + bf;
+        uint sum = std::bit_cast<uint>(float(native_sum));
+#else
+        float af = asfloat(a), bf = asfloat(b);
+        float native_sum = spirv_asm {
+            OpFAdd $$float %v $af $bf;
+            OpDecorate %v NoContraction;
+            OpCopyObject $$float result %v;
+        };
+        uint sum = asuint(native_sum);
+#endif
+        if (PB32Abs(sum) != 0u) return sum;
+        if (a == PB32Negate(b)) return 0u;
+    }
+#endif
     if (PB32Nan(a) || PB32Nan(b)) return 0x7fc00000u;
