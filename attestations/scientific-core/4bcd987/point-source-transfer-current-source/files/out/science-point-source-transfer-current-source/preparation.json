  "reference": {
    "derivation_scope": "g^5 B_lambda(g lambda,T)=B_lambda(lambda,gT) at fixed observed band; normalize by original source-temperature catalogue factor, then multiply catalogue flux and detector density once. Independent Lorentz angular area is distinct from fixed-band gain; no additional bolometric g^4.",
    "independent_reference": "tests/support/point_source_band_reference.h reimplements defining Planck equation with exact SI h,c,k and long-double arithmetic; no call to production Planck/colour/transfer helpers. Original matching-function coefficients and rational XYZ/RGB matrix express the same defined fits; this is not an independent all-wavelength CIE-table accuracy claim.",
    "nist_2022": {
      "bytes": 40801,
      "edition": "2022 CODATA adjustment",
      "http_headers": {
        "Content-Type": "text/plain",
        "ETag": "\"9f61-617e1b8c9228e\"",
        "Last-Modified": "Tue, 07 May 2024 18:54:55 GMT"
      },
      "precision_note": "h, c and k are exact SI defining constants. Listed sigma and wavelength Wien b have ellipses: source 5.670374419e-8 and 2.897771955e-3 retain their existing truncated decimal representations of exact-derived quantities, not new exact finite decimals.",
      "primary_rows": {
        "Boltzmann constant": "Boltzmann constant                                          1.380 649 e-23           (exact)                  J K^-1",
        "Planck constant": "Planck constant                                             6.626 070 15 e-34        (exact)                  J Hz^-1",
        "Stefan-Boltzmann constant": "Stefan-Boltzmann constant                                   5.670 374 419... e-8     (exact)                  W m^-2 K^-4",
        "Wien wavelength displacement law constant": "Wien wavelength displacement law constant                   2.897 771 955... e-3     (exact)                  m K",
        "first radiation constant for spectral radiance": "first radiation constant for spectral radiance              1.191 042 972... e-16    (exact)                  W m^2 sr^-1",
        "second radiation constant": "second radiation constant                                   1.438 776 877... e-2     (exact)                  m K",
