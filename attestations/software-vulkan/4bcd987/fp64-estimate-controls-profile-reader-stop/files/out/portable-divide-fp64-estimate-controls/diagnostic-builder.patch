+def diagnostic_divide_fp64_estimate_controls(text, normal_sum32=False, inlined_camera=False):
+    """Admit only the private double estimate; retain original normal32 policy."""
+    if sorted(re.findall(r"OpCapability (\S+)", text)) != ["Float64", "Shader"]:
+        raise ValueError("diagnostic estimate requires exactly Shader+Float64")
+    if (set(re.findall(r"OpTypeInt (\d+) [01]", text)) != {"32"} or
+            sorted(re.findall(r"OpTypeFloat (\d+)", text)) != (["32", "64"] if normal_sum32 else ["64"])):
+        raise ValueError("diagnostic estimate changed integer/float widths")
+    wide = re.search(r"(%\S+) = OpTypeFloat 64", text)[1]
+    named = (re.search(r"OpEntryPoint GLCompute (%\S+)", text)[1] if inlined_camera else
+             re.search(r'OpName (%\S+) "PB32Divide"', text)[1])
+    body = re.search(r"^\s*" + re.escape(named) + r" = OpFunction .*?OpFunctionEnd", text, re.M | re.S)[0]
+    count = 2 if inlined_camera else 1
+    operations = re.findall(r"^\s*(%\S+) = (OpF(?!unction)\S+) " + re.escape(wide) + r" .*?$", text, re.M)
+    if [kind for _, kind in operations] != ["OpFMul", "OpFDiv"] * count:
+        raise ValueError("diagnostic estimate changed its two wide operations")
+    converted = re.findall(r"^\s*(%\S+) = OpConvertUToF " + re.escape(wide) + r" .*?$", text, re.M)
+    decorated = set(re.findall(r"OpDecorate (%\S+) NoContraction", text))
+    if (len(converted) != 2 * count or any(value not in decorated for value, _ in operations) or
+            any(not re.search(r"^\s*" + re.escape(value) + r" =", body, re.M)
+                for value in [*[value for value, _ in operations], *converted])):
+        raise ValueError("diagnostic estimate lost its scoped conversion/order graph")
+    if (re.search(r"= OpExtInst " + re.escape(wide) + r" ", text) or
+            re.search(r"\bOpConvertFTo[SU]\b", text)):
+        raise ValueError("diagnostic estimate added a wide extended instruction or float-to-integer conversion")
+    # Validation-only projection of the complete module. It is never compiled,
+    # assembled or loaded. Every admitted wide instruction is checked above;
+    # original float32 body/order/dependency/mode guards inspect everything else.
+    view = re.sub(r"(?m)^.*OpCapability Float64\n", "", text)
+    view = re.sub(r"(?m)^.*= OpTypeFloat 64\n", "", view)
+    for value in [*[value for value, _ in operations], *converted]:
+        view = re.sub(r"(?m)^\s*" + re.escape(value) + r" = .*\n", "", view)
+    if not normal_sum32:
+        if "OpTypeFloat" in view or re.search(r"OpExecutionMode\S* .* (?:Denorm|RoundingMode|SignedZeroInfNan)", view):
+            raise ValueError("diagnostic portable stage introduced other native arithmetic")
+        return text
+    portable_normal_sum_controls(view)
+    entry = re.search(r"OpEntryPoint GLCompute (%\S+)", text)[1]
+    text = text.replace("OpCapability Shader", "OpCapability Shader\n               OpCapability RoundingModeRTE", 1)
+    local_size = re.search(r"^.*OpExecutionMode " + re.escape(entry) + r" LocalSize.*$", text, re.M)[0]
+    return text.replace(local_size, local_size + "\n               OpExecutionMode " + entry + " RoundingModeRTE 32", 1)
