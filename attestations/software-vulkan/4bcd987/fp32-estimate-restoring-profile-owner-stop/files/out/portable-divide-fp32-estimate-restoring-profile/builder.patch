+def diagnostic_divide_fp32_proposals(text, camera=False):
+    """Scope untrusted Float32 proposals only; graph admission is separate."""
+    if (re.findall(r"OpCapability (\S+)",text)!=["Shader"] or
+            set(re.findall(r"OpTypeInt (\d+) [01]",text))!={"32"} or
+            re.findall(r"OpTypeFloat (\d+)",text)!=["32"]):
+        raise ValueError("private proposal changed scalar/capability contract")
+    if re.search(r"\b(?:FPFastMathMode|FPFastMathDefault|RelaxedPrecision|NoUnsignedWrap|NoSignedWrap|OpFmaKHR|OpConvertFTo[SU]|OpConvert[SU]ToF)\b",text):
+        raise ValueError("private proposal introduced relaxed/wide/conversion arithmetic")
+    f32=re.search(r"(%\S+) = OpTypeFloat 32",text)[1]
+    divisions=re.findall(r"^\s*(%\S+) = OpFDiv "+re.escape(f32)+r" (%\S+) (%\S+)$",text,re.M)
+    expected=2 if camera else 1
+    if len(divisions)!=expected:
+        raise ValueError("private proposal count differs from selected named/inlined profile")
+    definitions=dict(re.findall(r"^\s*(%\S+) = (.+)$",text,re.M))
+    named=re.findall(r'OpName (%\S+) "PB32Divide"',text)
+    if camera:
+        if named:raise ValueError("camera proposal profile unexpectedly retained named Divide")
+        function=re.search(r"OpEntryPoint GLCompute (%\S+)",text)[1]
+    else:
+        if len(named)!=1:raise ValueError("private proposal lost unique named Divide")
+        function=named[0]
+    body=re.search(r"^\s*"+re.escape(function)+r" = OpFunction\b.*?OpFunctionEnd",text,re.M|re.S)[0]
+    for value,left,right in divisions:
+        if not re.search(r"^\s*"+re.escape(value)+r" = OpFDiv ",body,re.M):
+            raise ValueError("proposal escaped selected function")
+        if any(not definitions[x].startswith("OpBitcast "+f32+" ") for x in (left,right)):
+            raise ValueError("proposal operands lost bitcast construction")
+        if re.search(r"^\s*OpDecorate "+re.escape(value)+r"\b",text,re.M):
+            raise ValueError("proposal unexpectedly already decorated")
+    if re.findall(r"= (OpF(?!unction)\S+) ",body)!=["OpFDiv"]*expected:
+        raise ValueError("proposal scope includes another native operation")
+    return [row[0] for row in divisions]
+
+
+def diagnostic_divide_fp32_proposal_annotation(text, camera=False):
+    proposals=diagnostic_divide_fp32_proposals(text,camera)
+    annotation="".join("\n               OpDecorate "+value+" NoContraction" for value in proposals)
+    decorations=list(re.finditer(r"^.*OpDecorate .*?$",text,re.M))
+    if not decorations:raise ValueError("missing original decoration section")
+    point=decorations[-1].end();answer=text[:point]+annotation+text[point:]
+    if answer.count(annotation)!=1 or answer.replace(annotation,"",1)!=text:
+        raise ValueError("proposal annotation is not exactly reversible")
+    return answer
+
+
+def diagnostic_divide_fp32_controls(text, normal_sum32=False, camera=False):
+    """Retain original normal32 checks, admitting only scoped proposal FDivs."""
+    # Inspect the undecorated preimage so the same scope check also proves the
+    # annotation set exactly. The complete annotated module is assembled.
+    f32=re.search(r"(%\S+) = OpTypeFloat 32",text)[1]
+    values=re.findall(r"^\s*(%\S+) = OpFDiv "+re.escape(f32)+r" .*?$",text,re.M)
+    raw=text
+    for value in values:
+        line="\n               OpDecorate "+value+" NoContraction"
+        if raw.count(line)!=1:raise ValueError("proposal lost unique NoContraction")
+        raw=raw.replace(line,"",1)
+    if diagnostic_divide_fp32_proposals(raw,camera)!=values:
+        raise ValueError("proposal annotation scope mismatch")
+    view=text
+    for value in values:
+        view,count=re.subn(r"(?m)^\s*"+re.escape(value)+r" = OpFDiv [^\n]*\n","",view)
+        if count!=1:raise ValueError("proposal projection not unique")
+    if normal_sum32:
+        portable_normal_sum_controls(view)  # validation-only original body/order guards
+        entry=re.search(r"OpEntryPoint GLCompute (%\S+)",text)[1]
+        local=re.search(r"^.*OpExecutionMode "+re.escape(entry)+r" LocalSize.*$",text,re.M)[0]
+        return text.replace("OpCapability Shader","OpCapability Shader\n               OpCapability RoundingModeRTE",1).replace(local,local+"\n               OpExecutionMode "+entry+" RoundingModeRTE 32",1)
+    if re.search(r"= OpF(?!unction)\S+ |OpExecutionMode\S* .* (?:Denorm|RoundingMode|SignedZeroInfNan)",view):
+        raise ValueError("legacy portable proposal contains other floating arithmetic/modes")
+    if (re.search(r"= OpExtInst "+re.escape(f32)+r" ",view) or
+            re.search(r"\bOpDot\b|\bOpQuantizeToF16\b|\bOp(?:Vector|Matrix)Times\w+\b|\bOpOuterProduct\b",view)):
+        raise ValueError("legacy portable proposal contains float intrinsic/vector arithmetic")
+    return text
 
 
