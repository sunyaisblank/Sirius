+def diagnostic_divide_fp32_proposal_annotation(text):
+    """Add the known missing order annotation before the unchanged strict policy."""
+    floating = re.findall(r"(%\S+) = OpTypeFloat (\d+)", text)
+    if len(floating) != 1 or floating[0][1] != "32":
+        raise ValueError("diagnostic FP32 annotation requires exactly binary32")
+    float_type = floating[0][0]
+    named = re.findall(r'OpName (%\S+) "PB32Divide"', text)
+    if len(named) != 1:
+        raise ValueError("diagnostic FP32 annotation lost its unique Divide")
+    body = re.search(r"^\s*" + re.escape(named[0]) + r" = OpFunction .*?OpFunctionEnd", text, re.M | re.S)
+    divisions = re.findall(r"^\s*(%\S+) = OpFDiv " + re.escape(float_type) + r" .*?$", text, re.M)
+    if (not body or len(divisions) != 1 or
+            re.findall(r"= (OpF(?!unction)\S+) ", body[0]) != ["OpFDiv"] or
+            not re.search(r"^\s*" + re.escape(divisions[0]) + r" = OpFDiv ", body[0], re.M) or
+            re.search(r"^\s*OpDecorate " + re.escape(divisions[0]) + r"\b", text, re.M)):
+        raise ValueError("diagnostic FP32 annotation requires one unannotated scoped proposal")
+    annotation = "\n               OpDecorate " + divisions[0] + " NoContraction"
+    decorations = list(re.finditer(r"^.*OpDecorate .*?$", text, re.M))
+    if not decorations:
+        raise ValueError("diagnostic FP32 annotation requires original decoration section")
+    point = decorations[-1].end()
+    transformed = text[:point] + annotation + text[point:]
+    if transformed.count(annotation) != 1 or transformed.replace(annotation, "", 1) != text:
+        raise ValueError("diagnostic FP32 annotation is not exactly reversible")
+    return transformed
+
+
+def diagnostic_divide_fp32_normal_sum_controls(text):
+    """Admit one private binary32 proposal, retaining the original normal policy."""
+    if (re.findall(r"OpCapability (\S+)", text) != ["Shader"] or
+            set(re.findall(r"OpTypeInt (\d+) [01]", text)) != {"32"} or
+            re.findall(r"OpTypeFloat (\d+)", text) != ["32"]):
+        raise ValueError("diagnostic FP32 proposal changed capability or scalar widths")
+    float_type = re.search(r"(%\S+) = OpTypeFloat 32", text)[1]
+    named = re.search(r'OpName (%\S+) "PB32Divide"', text)[1]
+    body = re.search(r"^\s*" + re.escape(named) + r" = OpFunction .*?OpFunctionEnd", text, re.M | re.S)[0]
+    divisions = re.findall(r"^\s*(%\S+) = OpFDiv " + re.escape(float_type) + r" .*?$", text, re.M)
+    if (len(divisions) != 1 or re.findall(r"= (OpF(?!unction)\S+) ", body) != ["OpFDiv"] or
+            not re.search(r"^\s*" + re.escape(divisions[0]) + r" = OpFDiv ", body, re.M) or
+            not re.search(r"OpDecorate " + re.escape(divisions[0]) + r" NoContraction(?:\s|$)", text)):
+        raise ValueError("diagnostic FP32 proposal lost its single scoped division/order")
+    # Validation-only projection. It is never assembled or loaded. Only the
+    # scoped proposal instruction is removed; all original normal32 functions,
+    # dependency chains, types, float modes and relaxed-arithmetic bans remain.
+    view, count = re.subn(r"(?m)^\s*" + re.escape(divisions[0]) + r" = OpFDiv [^\n]*\n", "", text)
+    if count != 1:
+        raise ValueError("diagnostic FP32 proposal projection is not unique")
+    portable_normal_sum_controls(view)
+    entry = re.search(r"OpEntryPoint GLCompute (%\S+)", text)[1]
+    text = text.replace("OpCapability Shader", "OpCapability Shader\n               OpCapability RoundingModeRTE", 1)
+    local_size = re.search(r"^.*OpExecutionMode " + re.escape(entry) + r" LocalSize.*$", text, re.M)[0]
+    return text.replace(local_size, local_size + "\n               OpExecutionMode " + entry + " RoundingModeRTE 32", 1)
+
