+def verify_previous_cost_premise():
+    previous = json.loads((WORK / "origins.json").read_text())["previous_actual_JIT"]
+    assert re.fullmatch(r"[0-9a-f]{40}", previous["commit"])
+    archive = Path(previous["archive"])
+    manifest_path = archive / "manifest.json"
+    assert content(manifest_path) == previous["manifest"]
+    manifest = json.loads(manifest_path.read_text())["files"]
+    result_path = archive / previous["cost_result_member"]
+    admission_path = archive / previous["root_admission_member"]
+    for path, member in ((result_path, previous["cost_result_member"]), (admission_path, previous["root_admission_member"])):
+        assert content(path) == manifest[member]
+    result = json.loads(result_path.read_text())
+    admission = json.loads(admission_path.read_text())
+    assert result["passed"] and admission["passed"]
+    assert result["decision"] == admission["decision"] == "COST_PREMISE_SURVIVES_UNPROVEN"
+    assert result["source_join"]["candidate_header_sha256"] == "c21eb8259f2ed51bce2333ded7065c820dd782cf32ce5e46ea8976166503cdb5"
+    assert content(result_path) == {key: admission["cost_review"][key] for key in ("bytes", "sha256")}
+    assert not result["retained_arithmetic_executed_by_canary"]
+    assert not admission["retained_arithmetic_or_performance_or_hitrate_or_adoption_or_qualification_admitted"]
+    return {"commit": previous["commit"], "manifest": record(manifest_path), "cost_result": record(result_path),
+            "root_admission": record(admission_path), "decision": result["decision"],
+            "scope": "Relevant immutable source/cost decision only; old JIT933 input proof not repeated as new compiler inputs."}
 
 
